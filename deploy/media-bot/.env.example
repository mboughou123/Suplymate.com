# Copy to .env (git-ignored) next to docker-compose.yml.

# Suplymate site the bot pushes to, and the same CRON_SECRET as on Vercel.
SUPLYMATE_URL=https://suplymate.com
CRON_SECRET=

# Password for the bot's own Postgres (AI results + push fingerprints).
AI_CACHE_DB_PASSWORD=

# Free local vision model served by Ollama. qwen2.5vl:3b runs on CPU with
# ~4 GB RAM; machines with 12+ GB (or a GPU) can use qwen2.5vl:7b or llama3.2-vision.
LOCAL_AI_VISION_MODEL=qwen2.5vl:3b

# all, or a comma list: metals,construction,packaging,machinery,
# hardware-components,biomedical,electrical-industrial,logistics-insurance
MEDIA_BOT_INDUSTRIES=all
MEDIA_BOT_EVERY_MINUTES=60

# Host folder mounted at /data/media (inbox/ and needs/ live inside).
MEDIA_BOT_DATA_DIR=./data
